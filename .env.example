# ====================================================================
# Smart Canteen - Safe Local Environment Configuration Example
# ====================================================================
# Copy this file to '.env' or export these environment variables in your terminal.
# NEVER commit real passwords or personal production secrets to Git!
#
# On Windows PowerShell:
#   $env:SPRING_PROFILES_ACTIVE="mysql"
#   $env:SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/smart_canteen_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
#   $env:SPRING_DATASOURCE_USERNAME="root"
#   $env:SPRING_DATASOURCE_PASSWORD="your_mysql_password_here"
#
# On Linux/macOS:
#   export SPRING_PROFILES_ACTIVE=mysql
#   export SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_canteen_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
#   export SPRING_DATASOURCE_USERNAME=root
#   export SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

SPRING_PROFILES_ACTIVE=mysql
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_canteen_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here
SERVER_PORT=8080
CANTEEN_KITCHEN_CONCURRENCY=2
CANTEEN_DEFAULT_ITEM_PREP_MINUTES=5
